#!/bin/sh
# Resolve $0 through symlinks so basedir is the shim's real directory.
# Cap hops at the kernel's ELOOP limit so a cycle cannot hang the shim.
link="$0"
hops=0
while [ -L "$link" ] && [ "$hops" -lt 40 ]; do
  hops=$((hops+1))
  target=$(readlink "$link")
  case "$target" in
    /*) link="$target" ;;
    *)  link="$(dirname "$link")/$target" ;;
  esac
done
basedir=$(dirname "$(echo "$link" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspaces/Barber-main/node_modules/.pnpm/prisma@8.0.0-rc.13_@types+node@24.10.4_@types+react@19.2.14_@vercel+nft@1.11.0_drizzle-_4229756ddf50efab828786ff1f1c479b/node_modules/prisma/node_modules:/workspaces/Barber-main/node_modules/.pnpm/prisma@8.0.0-rc.13_@types+node@24.10.4_@types+react@19.2.14_@vercel+nft@1.11.0_drizzle-_4229756ddf50efab828786ff1f1c479b/node_modules:/workspaces/Barber-main/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspaces/Barber-main/node_modules/.pnpm/prisma@8.0.0-rc.13_@types+node@24.10.4_@types+react@19.2.14_@vercel+nft@1.11.0_drizzle-_4229756ddf50efab828786ff1f1c479b/node_modules/prisma/node_modules:/workspaces/Barber-main/node_modules/.pnpm/prisma@8.0.0-rc.13_@types+node@24.10.4_@types+react@19.2.14_@vercel+nft@1.11.0_drizzle-_4229756ddf50efab828786ff1f1c479b/node_modules:/workspaces/Barber-main/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../prisma/dist/prisma.js" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../prisma/dist/prisma.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../prisma/dist/prisma.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../prisma/dist/prisma.js" "$@"
else
  exec node  "$basedir/../prisma/dist/prisma.js" "$@"
fi
